generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Session {
  id            String   @id
  userId        String
  phoneNumber   String?
  webhookUrl    String?
  apiKeyMasked  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("sessions")
}

