generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["views"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String   @id // Clerk user id
  email          String   @unique
  freemiusUserId String?  @unique
  planId         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("users")
}

model Session {
  id            String   @id
  userId        String
  phoneNumber   String?
  webhookUrl    String?
  apiKeyMasked  String?
  isDeleted     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("sessions")
}

/// Non-deleted sessions only (backed by the `active_sessions` view). Read-only —
/// create, soft-delete, and field updates go through `Session`.
view ActiveSession {
  id           String   @unique
  userId       String
  phoneNumber  String?
  webhookUrl   String?
  apiKeyMasked String?
  createdAt    DateTime
  updatedAt    DateTime

  @@map("active_sessions")
}

