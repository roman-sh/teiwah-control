{
  "name": "teiwah-control",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start --env-file .env",
    "//start:dev": "control only — no cloudflared",
    "start:dev": "nest start --watch --env-file .env",
    "//predev": "cloudflared in background; npm runs this automatically before dev",
    "predev": "bash -c 'set -a && source .env && set +a && cloudflared tunnel run --token \"$CLOUDFLARED_TUNNEL_TOKEN\" &'",
    "//dev": "tunnel (predev) + control — local dev with cloud k3s",
    "dev": "nest start --watch --env-file .env",
    "start:debug": "nest start --debug --watch --env-file .env",
    "start:prod": "node dist/main.js",
    "//tunnel": "cloudflared only, foreground — Ctrl+C stops it",
    "tunnel": "bash -c 'set -a && source .env && set +a && exec cloudflared tunnel run --token \"$CLOUDFLARED_TUNNEL_TOKEN\"'",
    "lint": "eslint \"{src,apps,libs}/**/*.ts\" --fix"
  },
  "dependencies": {
    "@clerk/backend": "^3.8.0",
    "@freemius/sdk": "^0.3.0",
    "@kubernetes/client-node": "^1.4.0",
    "@logtail/pino": "^0.5.8",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bullmq": "^5.79.0",
    "nestjs-pino": "^4.6.1",
    "pg": "^8.21.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "unique-names-generator": "^4.7.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.20.0",
    "@types/pino": "^7.0.4",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "prettier": "^3.4.2",
    "prisma": "^7.8.0",
    "source-map-support": "^0.5.21",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
