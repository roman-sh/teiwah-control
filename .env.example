# 'production' uses live Freemius checkout; anything else (default 'development')
# opens the checkout overlay in sandbox/test mode. Coolify sets this per deploy.
NODE_ENV=development

PORT=4007

# --- Local dev (cloud k3s + tunnel on this machine) ---
# npm run dev       — predev starts cloudflared in background, then control (:4007)
# npm run tunnel    — cloudflared only (foreground; Ctrl+C stops it)
# npm run start:dev — control only, no tunnel
# Also run teiwah-zuplo on :9000 (dev-api.teiwah.cloud routes there via same tunnel)
# n8n POST /messages → https://dev-api.teiwah.cloud/messages

# URL injected into worker pods so they can call back to control
# Remote k3s + local control: https://dev-control.teiwah.cloud (npm run dev starts tunnel + control)
# Local k3d only: http://host.docker.internal:4007
# Prod (Coolify): https://control.teiwah.cloud
CONTROL_APP_BASE_URL=

# Cloudflare tunnel token — Zero Trust → teiwah-local-dev → connector (quote the value)
CLOUDFLARED_TUNNEL_TOKEN=

DATABASE_URL=

# k8s namespace and worker pod spec — match Coolify production
K8S_NAMESPACE=default
SESSION_WORKER_IMAGE=ghcr.io/roman-sh/teiwah-worker:amd64
SESSION_WORKER_PORT=5335
IMAGE_PULL_SECRET=ghcr-pull

# Local dev only — kubeconfig for cloud k3s (omit in Coolify).
# File: k3s-cloud.yaml in this directory (gitignored). loadFromDefault() reads KUBECONFIG.
# One-time: scp root@<k3s-host>:/etc/rancher/k3s/k3s.yaml k3s-cloud.yaml
# Then set clusters[].cluster.server to https://<k3s-host>:6443 (public API; we use 178.105.212.172)
# If :6443 is not public, use https://127.0.0.1:6443 + SSH tunnel instead.
KUBECONFIG=k3s-cloud.yaml

# Zuplo Developer API (Settings → Zuplo API Keys)
# Local dev: working-copy bucket; prod Coolify: separate production bucket
ZUPLO_API_KEY=
ZUPLO_ACCOUNT=
ZUPLO_KEY_BUCKET=
ZUPLO_API_BASE=https://dev.zuplo.com/v1

# Freemius
FS_PRODUCT_ID=32169
FS_PLAN_ID=52791
FS_PRICING_ID=69421
FS_API_KEY=<API Bearer Authorization Token>
FS_PUBLIC_KEY=<Product Public Key pk_…>
FS_SECRET_KEY=<Product Secret Key sk_…>

# Redis
REDIS_URL=redis://localhost:6379