# teiwah-control — environment variables (CANONICAL RUNBOOK)
#
# Documentation layering (avoid duplicating long prose elsewhere):
#   This file        — what to set, local vs prod values
#   env.schema.ts    — validation contract only
#   k8s.service.ts   — pod injection wiring (no values, no product docs)
#   nestwaileys/.env.example — local standalone worker; copy values from here

# -----------------------------------------------------------------------------
# CONTROL APP
# -----------------------------------------------------------------------------

# 'production' = live Freemius checkout; 'development' = sandbox overlay.
NODE_ENV=development
PORT=4007

DATABASE_URL=
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# LOCAL DEV — cloud k3s + Cloudflare tunnel on this machine
# -----------------------------------------------------------------------------
# npm run dev       — predev starts cloudflared in background, then control (:4007)
# npm run tunnel    — cloudflared only (foreground)
# npm run start:dev — control only, no tunnel
# Also run teiwah-zuplo on :9000 (dev-api.teiwah.cloud → :9000 via tunnel)
# n8n POST /messages → https://dev-api.teiwah.cloud/messages

CLOUDFLARED_TUNNEL_TOKEN=

# -----------------------------------------------------------------------------
# WORKER POD ENV — injected by k8s.service.ts at provision time
# -----------------------------------------------------------------------------
# Control reads these from its own env and forwards them into every session pod.
# Also injected but not listed here — see k8s.service.ts `env:` block:
#   SESSION_ID, NODE_ENV, SESSION_STORAGE_PATH  (provision-time)
#   PORT                                        (from SESSION_WORKER_PORT)

# Worker → control (internal). Pods call GET/PATCH /sessions/:id on this base.
# Local dev + cloud k3s: https://dev-control.teiwah.cloud (tunnel → :4007)
# Local k3d only: http://host.docker.internal:4007
# Prod (Coolify): https://control.teiwah.cloud
CONTROL_APP_BASE_URL=

# Customer-facing Zuplo gateway — worker builds inbound media.url from this.
# GET /media/:id through Zuplo (Bearer), same as POST /messages. Never worker direct.
# Local dev: https://dev-api.teiwah.cloud   Prod: https://api.teiwah.cloud
PUBLIC_API_BASE_URL=https://dev-api.teiwah.cloud

# Becomes PORT inside the pod.
SESSION_WORKER_PORT=5335

# Control logs here AND forwards to each worker pod. REQUIRED everywhere.
# LOG_LEVEL: fatal|error|warn|info|debug|trace (default: info)
# BETTERSTACK_INGESTING_HOST — host only, no scheme
LOG_LEVEL=info
BETTERSTACK_SOURCE_TOKEN=
BETTERSTACK_INGESTING_HOST=

# -----------------------------------------------------------------------------
# K8S PROVISIONING — control only (not injected into pods)
# -----------------------------------------------------------------------------

# Local dev (Dev Flow B): sandbox  — keeps dev session pods out of prod.
# Prod (Coolify): default. First-time dev setup: `make sandbox-setup` in teiwah-infra.
K8S_NAMESPACE=sandbox
SESSION_WORKER_IMAGE=ghcr.io/roman-sh/teiwah-worker:amd64
IMAGE_PULL_SECRET=ghcr-pull

# Local dev only — kubeconfig for cloud k3s (omit in Coolify).
# File: k3s-cloud.yaml in this directory (gitignored).
KUBECONFIG=k3s-cloud.yaml

# -----------------------------------------------------------------------------
# ZUPLO DEVELOPER API (control only)
# -----------------------------------------------------------------------------

ZUPLO_API_KEY=
ZUPLO_ACCOUNT=
ZUPLO_KEY_BUCKET=
ZUPLO_API_BASE=https://dev.zuplo.com/v1

# -----------------------------------------------------------------------------
# FREEMIUS + CLERK (control only)
# -----------------------------------------------------------------------------

FS_PRODUCT_ID=32169
FS_PLAN_ID=53580
FS_PRICING_ID=69421
FS_API_KEY=<API Bearer Authorization Token>
FS_PUBLIC_KEY=<Product Public Key pk_…>
FS_SECRET_KEY=<Product Secret Key sk_…>

CLERK_SECRET_KEY=<Clerk Secret Key sk_…>
